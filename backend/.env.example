# SafeFall AI backend. Copy to .env. NEVER commit real values.

# Supabase Postgres connection string (Project settings > Database). Uses the service role, so
# this process bypasses RLS and enforces authorization in code; RLS protects direct access.
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Signs the app's access tokens. Use the Supabase project's JWT secret so Supabase Realtime
# accepts the same token and applies the RLS policies in migrations/0002_rls.sql.
JWT_SECRET=replace-with-supabase-jwt-secret

# Server-side pepper for access-code lookups. 32+ random bytes. Rotating it invalidates codes.
ACCESS_CODE_PEPPER=replace-with-long-random-value

# Firebase service account JSON (one line) for FCM. Leave empty and the API still runs, but every
# push is logged as failed with reason provider_unconfigured. Nothing is reported as sent.
FIREBASE_SERVICE_ACCOUNT_JSON=

PORT=8787
# Refuse plain HTTP (behind a TLS-terminating proxy). Must stay true in production.
REQUIRE_HTTPS=true
# Number of reverse proxies in front of this process, used for client IPs and HTTPS detection.
TRUST_PROXY_HOPS=1
# Comma-separated browser origins. Native apps send no Origin and need no entry.
CORS_ORIGINS=
