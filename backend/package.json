{
  "name": "safefall-backend",
  "version": "1.0.0",
  "private": true,
  "description": "SafeFall AI cloud API: access-code auth, sensor sync, incidents, caretaker push.",
  "main": "dist/server.js",
  "engines": { "node": ">=20.12" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "migrate": "tsx scripts/migrate.ts",
    "admin": "tsx scripts/admin.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "firebase-admin": "^13.6.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.11",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2"
  }
}
