# Environment for the web E2E run (Firebase emulators + simulator). Demo values only.
EXPO_PUBLIC_FIREBASE_API_KEY=demo-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-safefall.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-safefall
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-safefall.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef
EXPO_PUBLIC_FIREBASE_USE_EMULATOR=true
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
EXPO_PUBLIC_ENABLE_DEV_TOOLS=true
EXPO_PUBLIC_FALL_COUNTDOWN_SECONDS=10
EXPO_PUBLIC_DEFAULT_COUNTRY_CODE=91
