# SafeFall AI - environment template. Copy to `.env` and fill in. NEVER commit `.env`.
#
# EXPO_PUBLIC_* values are compiled into the app bundle and are visible to anyone who
# has the APK. Firebase web config values are identifiers, not secrets: access control
# is enforced by Firestore Security Rules (firestore.rules) and Firebase Auth.
# Do NOT put service-account keys, SMS gateway keys or any other secret here.

# --- Firebase (Firebase console > Project settings > Your apps > Web app config) ---
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# --- Local Firebase Emulator Suite (optional, development only) ---
# Android emulator reaches the host machine at 10.0.2.2; a physical phone needs your PC's LAN IP.
EXPO_PUBLIC_FIREBASE_USE_EMULATOR=false
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=10.0.2.2

# --- Emergency workflow ---
# Local emergency-services number shown as a call button on the alert screen (e.g. 112, 911).
# Leave empty to hide the button. SafeFall never dials automatically.
EXPO_PUBLIC_EMERGENCY_SERVICES_NUMBER=
# Seconds between a confirmed fall and escalation to caregivers (10-120, default 30).
EXPO_PUBLIC_FALL_COUNTDOWN_SECONDS=30
# Country calling code (digits only) applied to phone numbers typed without one, e.g. 91 or 1.
# Leave empty to require the full international format (+<country code>...).
EXPO_PUBLIC_DEFAULT_COUNTRY_CODE=

# --- Developer tools ---
# "true" shows the BLE simulator and test tools. Simulated devices are always labelled
# SIMULATED and their incidents are never sent to caregivers. Keep "false" for release builds
# (eas.json already forces false for the preview and production profiles).
EXPO_PUBLIC_ENABLE_DEV_TOOLS=false

# --- SafeFall cloud API (access-code sign-in, sync, caretaker alerts) ---
# Must be https:// (plain http is accepted only for localhost and the Android emulator host).
# Leave empty for a build with no backend. See docs/WIFI_UPGRADE.md.
EXPO_PUBLIC_API_URL=
# Optional: Supabase Realtime for faster caretaker updates. Polling works without these.
EXPO_PUBLIC_SUPABASE_URL=https://dbqcoslypbwbwkdhskzg.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRicWNvc2x5cGJ3YndrZGhza3pnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTM0MDgxNjMsImV4cCI6MjEwODk4NDE2M30.DZVpU2TOwie2tWz7NNt9Mqg6Yqihj_-a4O0We_5jPtk
# "true" shows local demo accounts on the sign-in screen. Never enable for production.
EXPO_PUBLIC_ENABLE_DEMO_MODE=
# "true" re-enables the older Firebase email sign-in. Off by default.
EXPO_PUBLIC_ENABLE_FIREBASE_AUTH=

# --- Native build files (paths; files themselves are git-ignored) ---
# GOOGLE_SERVICES_JSON=./google-services.json
# GOOGLE_SERVICES_PLIST=./GoogleService-Info.plist
# EAS_PROJECT_ID=
